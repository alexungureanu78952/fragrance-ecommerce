POSTGRES_DB=fragrance_db
POSTGRES_USER=fragrance_app
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/fragrance_db
SPRING_DATASOURCE_USERNAME=fragrance_app
SPRING_DATASOURCE_PASSWORD=change-me-local-only

STRIPE_SECRET_KEY=sk_test_replace-with-local-test-secret
STRIPE_WEBHOOK_SECRET=whsec_replace-with-local-test-secret
# Docker stack (docker compose up --build) is served at localhost:8081.
# If running the frontend dev server separately (npm run dev + Spring Boot on 8080),
# change these two URLs to http://localhost:5173.
STRIPE_SUCCESS_URL=http://localhost:8081/#/checkout/success
STRIPE_CANCEL_URL=http://localhost:8081/#/checkout/cancel

# Docker: API is same-origin through Apache (/api/v1). Dev server: point to Spring Boot directly.
VITE_API_URL=http://localhost:8080/api/v1
# Docker stack public URL (used for sitemap, canonical, and Open Graph tags).
VITE_SITE_URL=http://localhost:8081
# Dev server only: allow the Vite origin through CORS. Not needed for Docker.
APP_FRONTEND_ORIGIN=http://localhost:5173
VITE_CAPTCHA_SITE_KEY=your-public-hcaptcha-site-key

CAPTCHA_ENABLED=true
CAPTCHA_SECRET=replace-with-hcaptcha-secret
CAPTCHA_VERIFY_URL=https://hcaptcha.com/siteverify
